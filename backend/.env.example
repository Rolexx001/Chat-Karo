PORT=5000
MONGO_URI=mongodb://localhost:27017/chat-backend
REDIS_URL=redis://localhost:6379

ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# AI Provider Configuration (Google Gemini Free Models)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Tavily Web Search API (Optional, for web search tool)
TAVILY_API_KEY=

# LangSmith Tracing Configuration (Optional, set to true to trace chain executions)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=chat-backend-ai
